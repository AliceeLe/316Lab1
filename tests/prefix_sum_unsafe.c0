// Expect: unsafe
int[] main(int argc, int[] in)
//@requires argc >= 2;
//@requires argc % 2 == 0;
//@requires \length(in) == argc;
//@ensures \length(\result) == argc / 2;
{
    int n = argc / 2;
    int out_len = n;
    int[] out = alloc_array(int, out_len);

    out[0] = in[0];

    int i = 1;
    while (i <= n) // BUG: inclusive bound writes out[out_len]
    //@loop_invariant 1 <= i && i <= n;
    //@loop_invariant \length(in) == argc && argc >= 2 && argc % 2 == 0;
    //@loop_invariant \length(out) == out_len;
    //@loop_invariant 0 <= n && n == argc / 2;
    //@loop_invariant out_len == n;
    {
        int prev_sum = out[i - 1];
        int curr_val = in[i];
        out[i] = prev_sum + curr_val;
        i = i + 1;
    }

    return out;
}
