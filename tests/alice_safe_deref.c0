// expect: safe
int[] main(int argc, int[] in)
//@requires argc == 0;
//@requires \length(in) == argc;
//@ensures \length(\result) == 3;
{
    int* p = alloc(int);
    *p = 42;            // safe: p is allocated
    int[] res = alloc_array(int, 1);
    res[0] = *p;        // safe dereference
    return res;
}
