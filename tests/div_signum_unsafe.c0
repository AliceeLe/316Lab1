// Expect: unsafe
int[] main(int argc, int[] in)
//@requires argc >= 1;
//@requires \length(in) == argc;
//@ensures \length(\result) == 1;
{
    int sum = 0;
    int i = 1;
    while (i < argc)
    //@loop_invariant 1 <= i && i <= argc;
    //@loop_invariant \length(in) == argc && argc >= 1;
    {
        int d = in[i] - in[i - 1];
        int ad = d;
        if (ad < 0) {
            ad = -ad;
        }

        int s = 0;
        s = d / ad; // BUG: should test ad == 0
        sum = sum + s;
        i = i + 1;
    }

    int[] out = alloc_array(int, 1);
    out[0] = sum;
    return out;
}
