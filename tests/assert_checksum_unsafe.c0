// Expect: unsafe
int[] main(int argc, int[] in)
//@requires argc > 0;
//@requires \length(in) == argc;
//@ensures \length(\result) == 1;
{
    // Compute a simple checksum over all but the last element.
    int i = 0;
    int sum = 0;

    while (i + 1 < argc)
    //@loop_invariant 0 <= i && i + 1 <= argc;
    //@loop_invariant \length(in) == argc;
    {
        sum = sum + in[i];
        i = i + 1;
    }

    // In general this is not true
    assert(sum == in[argc - 1]);

    int[] out = alloc_array(int, 1);
    out[0] = sum;
    return out;
}

