// Expect: valid
int[] main(int argc, int[] in)
//@requires argc > 0;
//@requires \length(in) == argc;
//@ensures \length(\result) == argc;
{
    int min = in[0];
    int max = in[0];

    int i = 1;
    while (i < argc)
    //@loop_invariant 1 <= i && i <= argc;
    //@loop_invariant \length(in) == argc && argc > 0;
    {
        if (in[i] < min) {
            min = in[i];
        }
        if (in[i] > max) {
            max = in[i];
        }
        i = i + 1;
    }

    int range = max - min;
    if (range == 0) {
        range = 1;
    }

    int out_len = argc;
    int[] out = alloc_array(int, out_len);

    i = 0;
    while (i < out_len)
    //@loop_invariant 0 <= i && i <= out_len;
    //@loop_invariant out_len == argc && argc > 0;
    //@loop_invariant \length(in) == argc;
    //@loop_invariant \length(out) == out_len;
    //@loop_invariant range != 0;
    {
        out[i] = (in[i] - min) / range;
        i = i + 1;
    }

    return out;
}
