// Expect: valid
int[] main(int argc, int[] in)
//@requires argc >= 0;
//@requires \length(in) == argc;
//@ensures \length(\result) == argc;
{
    int[] out = alloc_array(int, argc);

    // Guard reads from `in` using explicit errors.
    if (argc == 0) {
        error("empty input");
    }

    int n = in[0];

    if (n < 0) {
        error("negative length");
    }

    if (n >= argc) {
        error("length too large");
    }

    int i = 0;
    while (i < n)
    //@loop_invariant 0 <= i && i <= n;
    //@loop_invariant 0 <= n && n < argc;
    //@loop_invariant \length(in) == argc;
    //@loop_invariant \length(out) == argc;
    {
        // Mix in a division and nested array reads to exercise parser hoisting.
        out[i] = in[i + 1] + (in[i + 1] / 3);
        i = i + 1;
    }

    while (i < argc)
    //@loop_invariant 0 <= i && i <= argc;
    //@loop_invariant 0 <= n && n < argc;
    //@loop_invariant \length(out) == argc;
    {
        out[i] = 0;
        i = i + 1;
    }

    return out;
}

