// Expect: valid
int[] main(int argc, int[] in)
//@requires argc >= 1;
//@requires \length(in) == argc;
//@ensures \length(\result) == 1;
{
    int mod = in[0] % 256;
    if (mod < 0) {
        mod = -mod;
    }
    mod = mod + 1; // Ensure mod is in [1,256]

    int h = 0;
    int i = 1;
    while (i < argc)
    //@loop_invariant 1 <= i && i <= argc;
    //@loop_invariant \length(in) == argc && argc >= 1;
    //@loop_invariant mod != 0;
    {
        h = (h * 31 + in[i]) % mod;
        i = i + 1;
    }

    int[] out = alloc_array(int, 1);
    out[0] = h;
    return out;
}
